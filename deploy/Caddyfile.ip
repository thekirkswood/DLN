# HTTP-only fallback (no TLS). VPS live edge is Caddyfile.prod.

:80 {
  encode gzip

  @modyu host modyu.designlabnorth.com
  handle @modyu {
    forward_auth web:3000 {
      uri /api/auth/gate?plot=modyu
      copy_headers Cookie
    }
    reverse_proxy plot-modyu:3000
  }

  @swarm host swarmfund.designlabnorth.com
  handle @swarm {
    forward_auth web:3000 {
      uri /api/auth/gate?plot=swarm
      copy_headers Cookie
    }
    reverse_proxy plot-swarm:3000
  }

  @daa host daa.designlabnorth.com
  handle @daa {
    redir http://designlabnorth.com
  }

  handle /p/modyu* {
    redir http://modyu.designlabnorth.com 302
  }
  handle /p/swarm* {
    redir http://swarmfund.designlabnorth.com 302
  }

  handle {
    reverse_proxy web:3000
  }
}
