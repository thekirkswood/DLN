# Plot host (until TLS + Livedns wildcard)

:80 {
  encode gzip

  @modyu host modyu.designlabnorth.com
  handle @modyu {
    forward_auth web:3000 {
      uri /api/auth/gate?plot=modyu
      copy_headers Cookie
    }
    reverse_proxy plot-modyu:3000
  }

  handle {
    reverse_proxy web:3000
  }
}

# Interim plot dock — same cookie as the apex while modyu.* has no A record.
# Close this port when Livedns answers for modyu.designlabnorth.com.
:3080 {
  encode gzip
  forward_auth web:3000 {
    uri /api/auth/gate?plot=modyu
    copy_headers Cookie
  }
  reverse_proxy plot-modyu:3000
}
