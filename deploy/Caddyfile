# Local only (localhost). VPS must use Caddyfile.ip — compose defaults to that.

{
  admin off
}

http://localhost {
  reverse_proxy web:3000
}

http://modyu.localhost {
  reverse_proxy /api/auth/gate* web:3000
  forward_auth web:3000 {
    uri /api/auth/gate?plot=modyu
    copy_headers Cookie
  }
  reverse_proxy plot-modyu:3000
}
