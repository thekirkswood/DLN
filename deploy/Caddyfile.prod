# Do not use this file on the VPS until Let’s Encrypt has issued certificates.
# A named HTTPS site with port 443 published and no cert makes browsers show the site as down.
# Live edge is Caddyfile.ip (HTTP :80 only). auto_https disable_redirects is required if this is enabled.
{
  email {$DLN_ACME_EMAIL:build@designlabnorth.com}
}

(edge) {
  encode gzip

  @dln_suggest {
    path /suggest /suggest/* /api/suggestions /api/suggestions/*
  }
  handle @dln_suggest {
    reverse_proxy web:3000
  }

  @modyu_static {
    host modyu.designlabnorth.com
    path /assets* /_next/static*
  }
  handle @modyu_static {
    reverse_proxy plot-modyu:3000
  }

  @modyu host modyu.designlabnorth.com
  handle @modyu {
    reverse_proxy plot-modyu:3000
  }

  @swarm_static {
    host swarmfund.designlabnorth.com
    path /assets*
  }
  handle @swarm_static {
    reverse_proxy plot-swarm:3000
  }

  @swarm host swarmfund.designlabnorth.com
  handle @swarm {
    forward_auth web:3000 {
      uri /api/auth/gate?plot=swarm
      copy_headers Cookie
    }
    reverse_proxy plot-swarm:3000
  }

  @daa host daa.designlabnorth.com
  handle @daa {
    redir {scheme}://designlabnorth.com
  }

  handle_path /p/modyu* {
    reverse_proxy plot-modyu:3000
  }

  handle /assets* {
    reverse_proxy plot-modyu:3000
  }

  handle_path /p/swarm* {
    forward_auth web:3000 {
      uri /api/auth/gate?plot=swarm
      copy_headers Cookie
    }
    reverse_proxy plot-swarm:3000
  }

  @home_desk {
    host designlabnorth.com www.designlabnorth.com
    path /lab* /admin* /go* /api/lab*
  }
  handle @home_desk {
    forward_auth web:3000 {
      uri /api/auth/studio-gate
      copy_headers Cookie
    }
    reverse_proxy host.docker.internal:13010 {
      header_up Host campus.dln.home
      header_up X-Forwarded-Host {host}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  handle {
    reverse_proxy web:3000
  }
}

# HTTP stays up even while certificates obtain.
http://designlabnorth.com, http://www.designlabnorth.com, http://modyu.designlabnorth.com, http://swarmfund.designlabnorth.com, http://daa.designlabnorth.com {
  import edge
}

designlabnorth.com, www.designlabnorth.com, modyu.designlabnorth.com, swarmfund.designlabnorth.com, daa.designlabnorth.com {
  tls {
    issuer acme {
      disable_tlsalpn_challenge
    }
  }
  import edge
}

# Own domain on this VPS. Separate site so the hub certificate is not rewritten.
http://varioustitles.com, http://www.varioustitles.com {
  encode gzip
  @www host www.varioustitles.com
  handle @www {
    redir http://varioustitles.com{uri} permanent
  }
  reverse_proxy plot-titles:3000
}

varioustitles.com, www.varioustitles.com {
  tls {
    issuer acme {
      disable_tlsalpn_challenge
    }
  }
  encode gzip
  @www host www.varioustitles.com
  handle @www {
    redir https://varioustitles.com{uri} permanent
  }
  reverse_proxy plot-titles:3000
}

# Swarm Fund public apex — ungated (app Building lock). Greenhouse copy stays on subdomain with forward_auth.
http://swarmfund.com, http://www.swarmfund.com {
  encode gzip
  @www host www.swarmfund.com
  handle @www {
    redir http://swarmfund.com{uri} permanent
  }
  reverse_proxy plot-swarm:3000
}

swarmfund.com, www.swarmfund.com {
  tls {
    issuer acme {
      disable_tlsalpn_challenge
    }
  }
  encode gzip
  @www host www.swarmfund.com
  handle @www {
    redir https://swarmfund.com{uri} permanent
  }
  reverse_proxy plot-swarm:3000
}
