{
  email {$DLN_ACME_EMAIL:build@designlabnorth.com}
  auto_https disable_redirects
}

designlabnorth.com, www.designlabnorth.com {
  encode gzip

  handle_path /p/modyu* {
    forward_auth web:3000 {
      uri /api/auth/gate?plot=modyu
      copy_headers Cookie
    }
    reverse_proxy plot-modyu:3000
  }

  handle /assets* {
    reverse_proxy plot-modyu:3000
  }

  handle_path /p/swarm* {
    forward_auth web:3000 {
      uri /api/auth/gate?plot=swarm
      copy_headers Cookie
    }
    reverse_proxy plot-swarm:3000
  }

  handle {
    reverse_proxy web:3000
  }
}

modyu.designlabnorth.com {
  encode gzip
  handle /assets* {
    reverse_proxy plot-modyu:3000
  }
  handle /_next/static* {
    reverse_proxy plot-modyu:3000
  }
  handle {
    forward_auth web:3000 {
      uri /api/auth/gate?plot=modyu
      copy_headers Cookie
    }
    reverse_proxy plot-modyu:3000
  }
}

swarmfund.designlabnorth.com {
  encode gzip
  handle /assets* {
    reverse_proxy plot-swarm:3000
  }
  handle {
    forward_auth web:3000 {
      uri /api/auth/gate?plot=swarm
      copy_headers Cookie
    }
    reverse_proxy plot-swarm:3000
  }
}

daa.designlabnorth.com {
  redir http://designlabnorth.com
}
