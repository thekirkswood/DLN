[Unit]
Description=Solport unit (Next :3070)
After=network-online.target campus.service

[Service]
Type=simple
WorkingDirectory=/home/main/Repos/solport/Site
Environment=PATH=/usr/bin:/bin
# Aktiv Grotesk. Set Dave’s Adobe Fonts web project id. Do not self-host the files.
# Environment=NEXT_PUBLIC_ADOBE_FONTS_KIT=
ExecStart=/usr/bin/npm run dev
Restart=always
RestartSec=8
KillMode=mixed

[Install]
WantedBy=default.target
