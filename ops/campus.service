[Unit]
Description=Design Lab North campus (Next.js :3010, this Cursor disk)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/main/DLN/Site
Environment=PATH=/usr/bin:/bin
Environment=NODE_ENV=development
EnvironmentFile=-/home/main/DLN/Site/.env.local
ExecStart=/usr/bin/npm run dev
Restart=always
RestartSec=8
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
