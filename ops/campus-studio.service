[Unit]
Description=Design Lab North picture engine (Social Engine :3060)
After=network-online.target campus.service

[Service]
Type=simple
WorkingDirectory=/home/main/Repos/Social engine
Environment=PATH=/usr/bin:/bin
Environment=NODE_ENV=development
EnvironmentFile=-/home/main/Repos/Social engine/.env.local
ExecStart=/usr/bin/npm run dev
Restart=always
RestartSec=8
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
