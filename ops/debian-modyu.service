[Unit]
Description=ModYu unit (Next :3000, lab prefix)
After=network-online.target campus.service

[Service]
Type=simple
WorkingDirectory=/home/main/ModYu/Site
Environment=PATH=/usr/bin:/bin
Environment=BASE_PATH=/go/modyu
ExecStart=/usr/bin/npm run dev
Restart=always
RestartSec=8
KillMode=mixed

[Install]
WantedBy=default.target
