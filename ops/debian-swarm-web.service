[Unit]
Description=Swarm web (Vite :5173, lab prefix)
After=network-online.target debian-swarm-api.service

[Service]
Type=simple
WorkingDirectory=/home/main/SwarmFund/apps/web
Environment=PATH=/usr/bin:/bin
Environment=VITE_BASE=/go/swarm/
Environment=VITE_API_BASE=/go/swarm/api
ExecStart=/usr/bin/npm run dev
Restart=always
RestartSec=8
KillMode=mixed

[Install]
WantedBy=default.target
