[Unit]
Description=Design Lab North campus on LAN (Next.js production :3010)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/main/DLN/Site
Environment=PATH=/usr/bin:/bin
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
EnvironmentFile=-/home/main/DLN/Site/.env.local
EnvironmentFile=-/home/main/DLN/_meta/secrets/home-dial.env
ExecStart=/home/main/DLN/ops/campus-lan.sh
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStartSec=180
TimeoutStopSec=30

[Install]
WantedBy=default.target
