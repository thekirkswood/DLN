[Unit]
Description=Paul Fosbury Portraits unit (Next :3030)
After=network-online.target campus.service

[Service]
Type=simple
WorkingDirectory=/home/main/PFP/Site
Environment=PATH=/usr/bin:/bin
ExecStart=/usr/bin/npm run dev
Restart=always
RestartSec=8
KillMode=mixed

[Install]
WantedBy=default.target
