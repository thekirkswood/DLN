[Unit]
Description=Various Titles unit (Next :3020)
After=network-online.target campus.service

[Service]
Type=simple
WorkingDirectory=/home/main/VariousTitles/Site
Environment=PATH=/usr/bin:/bin
ExecStart=/usr/bin/npm run dev
Restart=always
RestartSec=8
KillMode=mixed

[Install]
WantedBy=default.target
